# ---------------------------------------------------------------------------
# Kivi Semantic Memory - environment configuration
# Copy this file to `.env` (Windows: `copy .env.example .env`) and edit.
# EVERY value below has a working default. The system runs with an EMPTY .env.
# ---------------------------------------------------------------------------

# --- Language model -------------------------------------------------------
# Which provider drives memory extraction, conflict resolution and answering.
#   anthropic | groq | openai | gemini | heuristic
# "heuristic" is a fully offline, deterministic, rule-based engine. It needs no
# API key and lets a reviewer run the entire pipeline + evaluation with zero
# credentials. Quality is lower than an LLM but the pipeline is identical.
KIVI_LLM_PROVIDER=heuristic

# Model id for the chosen provider (leave blank to use the provider default).
#   anthropic default: claude-opus-5
#   groq default:      openai/gpt-oss-120b   (also: openai/gpt-oss-20b, cheaper)
#   openai default:    gpt-4o-mini
#   gemini default:    gemini-2.5-flash-lite  (also: gemini-2.5-flash)
KIVI_LLM_MODEL=

ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Embeddings -----------------------------------------------------------
# Which embedding backend powers semantic similarity.
#   hashing | openai | gemini | sentence-transformers
# "hashing" is a deterministic, dependency-free local embedder (hashed
# character+word n-grams, IDF weighted, L2 normalised). Offline and reproducible.
KIVI_EMBEDDING_PROVIDER=hashing
KIVI_EMBEDDING_MODEL=
KIVI_EMBEDDING_DIM=512

# --- Storage --------------------------------------------------------------
# SQLite file path. Three slashes means a path RELATIVE to the repository root,
# which is what you want locally.
#
# Do NOT copy this line into a hosted deployment. In the container the database
# has to sit on the mounted volume at /data, which is an ABSOLUTE path and so
# needs four slashes: sqlite:////data/kivi.db. The Dockerfile already sets that,
# so the correct action when hosting is to leave KIVI_DATABASE_URL unset rather
# than to set it. Setting the three-slash form there puts the database inside
# the container instead, where a restart discards it.
KIVI_DATABASE_URL=sqlite:///data/kivi.db

# --- Retrieval tuning -----------------------------------------------------
KIVI_RETRIEVAL_TOP_K=8
KIVI_RETRIEVAL_CANDIDATES=60
KIVI_SEMANTIC_WEIGHT=0.55
KIVI_LEXICAL_WEIGHT=0.30
KIVI_RECENCY_WEIGHT=0.15
KIVI_MIN_RETRIEVAL_SCORE=0.12

# --- Memory extraction tuning --------------------------------------------
# Extracted memories below this confidence are stored with status REJECTED
# (kept for inspection, never retrieved).
KIVI_MIN_MEMORY_CONFIDENCE=0.45

# --- Server ---------------------------------------------------------------
KIVI_DEFAULT_USER_ID=user_demo
KIVI_API_HOST=127.0.0.1
KIVI_API_PORT=8000
KIVI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
